# ── Configuración del backend OMNI (copiar a backend/.env) ───────────────────

# PostgreSQL (reemplaza a MONGO_URL). En local apunta al contenedor docker-compose.
# En AWS apunta al endpoint de Aurora (idealmente vía AWS Secrets Manager).
DATABASE_URL=postgresql://omni:omni@localhost:5432/omni

# Secreto para firmar los JWT (OBLIGATORIO). Genera uno robusto, p.ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=n_HLmbKTPXgkon5hXuUnLrJYGXBmsZ6I3H7ar2TcV3rdDtSnHunEVxjDQtJAEh-L

# Orígenes permitidos por CORS, separados por coma (sin espacios).
# Ej. prod: https://app.xuve.net,https://xuve.net
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# URL pública del backend (usada por la suite de tests de integración).
REACT_APP_BACKEND_URL=http://localhost:8001

# ── Google Maps Platform — LLAVE DE SERVIDOR (SECRETA) ───────────────────────
# Esta llave NUNCA debe ir al frontend. La consume backend/routes/geo_routes.py
# como proxy de: Places API, Directions API, Distance Matrix API, Geocoding API.
# En Google Cloud Console restríngela por:
#   - Application restrictions: IP addresses → IP pública del servidor AWS
#   - API restrictions: solo las 4 APIs de arriba
# En prod, inyéctala vía AWS Secrets Manager, no en texto plano.
GOOGLE_MAPS_SERVER_KEY=pega-aqui-la-llave-de-SERVIDOR

# ── Google Sign-In (OAuth) ───────────────────────────────────────────────────
# Client ID de OAuth de tu proyecto en Google Cloud. El backend lo usa como
# AUDIENCIA al verificar el ID token de Google en /api/auth/google/session.
# Sin esto, ese endpoint responde 503 (login con Google deshabilitado).
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── KYC (proveedor externo) y Pagos (suscripción $1/día) ─────────────────────
# Arquitectura lista para proveedor real vía webhooks. SIN estas API keys, los
# flujos reales NO operan. El MODO MOCK es OPT-IN y SOLO para local/dev: NUNCA
# lo pongas en true en producción (permitiría auto-aprobar KYC / activar gratis).
#   - Para probar en local descomenta:  KYC_MOCK_MODE=true  y  PAYMENTS_MOCK_MODE=true
#   - En prod: deja el mock apagado e inyecta las API keys reales en Secrets Manager.
# KYC_PROVIDER_API_KEY=
# KYC_WEBHOOK_SECRET=
# PAYMENTS_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=
KYC_MOCK_MODE=true
# PAYMENTS_MOCK_MODE=false

# ── Microservicio propio xuve-kyc-service (KYC progresivo + titularidad) ─────
# Motor de verificación de identidad y de titularidad de métodos de pago
# (T&C cláusulas 3.2 y 6). El backend le habla con el header X-KYC-API-KEY y
# verifica la firma HMAC-SHA256 de sus respuestas (header X-KYC-Signature).
# KYC_SERVICE_API_KEY debe coincidir con KYC_API_KEY del microservicio, y
# KYC_SERVICE_HMAC_SECRET con su HMAC_SIGNING_SECRET. Sin API key, los
# endpoints de métodos de pago y expedientes responden 503.
KYC_SERVICE_URL=http://localhost:8010
KYC_SERVICE_API_KEY=
KYC_SERVICE_HMAC_SECRET=
# Gate de KYC progresivo: exigir método de pago validado en el primer viaje.
# Apagar SOLO en arneses de prueba (PAYMENT_METHOD_GATE_ENABLED=false).
# PAYMENT_METHOD_GATE_ENABLED=true
